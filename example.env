# ---------------------------------------------------------------------------
# family_board — environment variables
# Copy to `.env` and fill in. None are committed (see .gitignore).
# ---------------------------------------------------------------------------

# Bearer token guarding every /api endpoint, including GET /api/calendar.
# REQUIRED: when unset, the API denies all requests with 503. Callers (e.g.
# the hub app) must send this same value as `Authorization: Bearer <token>`
# or `?token=<token>`. Use a long random string.
CALENDAR_API_TOKEN=change-me-to-a-long-random-secret

# Database connection.
# - Leave UNSET for local dev: a SQLite file is created at ./storage/family_board.db
# - Set to mysql:// or mariadb:// for production (enables the MySQL schema)
# DATABASE_URL=mysql://user:password@host:3306/family_board

# Set to "production" to enable secure (HTTPS-only) session cookies.
# NODE_ENV=production

# adapter-node listen options (optional; defaults shown).
# PORT=3000
# HOST=0.0.0.0
